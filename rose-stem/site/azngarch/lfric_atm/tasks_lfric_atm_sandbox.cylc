{% elif task_ns.conf_name == "clim_gal9_chem-C12_12x1" %}

    {% do task_dict.update({
        "opt_confs": ["climate","chemistry","um_dump","no_diags"],
        "resolution": "C12",
        "DT": 1800,
        "tsteps": 12,
        "mpi_parts": 12,
        "wallclock": 20,
        "threads": 1,
    }) %}

{% elif "chunking_chem_" in task_ns.conf_name %}

    {% set chunking_parts = task_ns.conf_name.split("-") %}
    {% set chunking_suffix = chunking_parts[0].replace("chunking_chem_", "") %}
    {% set chunking_run = chunking_parts[1] %}
    {% set chunking_run_parts = chunking_run.split("_") %}
    {% set chunking_resolution = chunking_run_parts[0] %}
    {% set chunking_mpi_threads = chunking_run_parts[1].split("x") %}
    {% set chunking_mpi_parts = chunking_mpi_threads[0] | int %}
    {% set chunking_threads = chunking_mpi_threads[1] | int %}
    {% set chunking_opt_confs = {
        "off": "ukca_full_chunking_off",
        "1_1_1": "ukca_full_chunking_1_1_1",
        "1_1_8": "ukca_full_chunking_1_1_8",
        "1_1_16": "ukca_full_chunking_1_1_16",
        "1_1_32": "ukca_full_chunking_1_1_32",
        "1_1_m1": "ukca_full_chunking_1_1_m1",
        "8_1_1": "ukca_full_chunking_8_1_1",
        "8_1_8": "ukca_full_chunking_8_1_8",
        "8_1_16": "ukca_full_chunking_8_1_16",
        "8_1_32": "ukca_full_chunking_8_1_32",
        "8_1_m1": "ukca_full_chunking_8_1_m1",
        "16_1_1": "ukca_full_chunking_16_1_1",
        "16_1_8": "ukca_full_chunking_16_1_8",
        "16_1_16": "ukca_full_chunking_16_1_16",
        "16_1_32": "ukca_full_chunking_16_1_32",
        "16_1_m1": "ukca_full_chunking_16_1_m1",
        "32_1_1": "ukca_full_chunking_32_1_1",
        "32_1_8": "ukca_full_chunking_32_1_8",
        "32_1_16": "ukca_full_chunking_32_1_16",
        "32_1_32": "ukca_full_chunking_32_1_32",
        "32_1_m1": "ukca_full_chunking_32_1_m1",
        "64_1_1": "ukca_full_chunking_64_1_1",
        "64_1_8": "ukca_full_chunking_64_1_8",
        "64_1_16": "ukca_full_chunking_64_1_16",
        "64_1_32": "ukca_full_chunking_64_1_32",
        "64_1_m1": "ukca_full_chunking_64_1_m1",
        "128_1_1": "ukca_full_chunking_128_1_1",
        "128_1_8": "ukca_full_chunking_128_1_8",
        "128_1_16": "ukca_full_chunking_128_1_16",
        "128_1_32": "ukca_full_chunking_128_1_32",
        "128_1_m1": "ukca_full_chunking_128_1_m1",
        "m1_1_1": "ukca_full_chunking_m1_1_1",
        "m1_1_8": "ukca_full_chunking_m1_1_8",
        "m1_1_16": "ukca_full_chunking_m1_1_16",
        "m1_1_32": "ukca_full_chunking_m1_1_32",
        "m1_1_m1": "ukca_full_chunking_m1_1_m1",
    } %}
    {% do task_dict.update({
        "opt_confs": ["climate", "chemistry_c48" if chunking_resolution == "C48_MG" else "chemistry", "um_dump", "no_diags", chunking_opt_confs[chunking_suffix]],
        "resolution": chunking_resolution,
        "DT": 1800,
        "tsteps": 12,
        "mpi_parts": chunking_mpi_parts,
        "wallclock": 20,
        "threads": chunking_threads,
        "memory": [16, "GB"]
    }) %}
{% endif %}

{# Set default values for lfric_atm tasks #}
{% if task_dict %}
    {% do task_dict.update({"application_dir": "lfric_apps/applications/lfric_atm"}) %}
    {% if "app_name" not in task_dict %}
        {% do task_dict.update({"app_name": "lfric_atm"}) %}
    {% endif %}
{% endif %}

{% do LOG.debug("Finished in site/azngarch/lfric_atm/tasks_lfric_atm_sandbox.cylc") %}

